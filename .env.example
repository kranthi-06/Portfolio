# Server-only secrets. Copy to .env.local and replace each value.
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Required before adding Supabase browser authentication and Storage uploads.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Analytics Configuration
# Recommended in production: 32+ character random string for visitor hashing.
# Generate with: openssl rand -hex 32
# If unset, the salt is derived from SUPABASE_SERVICE_ROLE_KEY so tracking keeps
# working (set ANALYTICS_SALT to keep visitor hashes stable across key rotations).
ANALYTICS_SALT=your_32_char_random_salt_here

# Rate limiting and data retention are configured in code (see middleware.ts and
# the route handlers), not via environment variables.

# Geolocation: Uses Vercel Edge Network headers (x-vercel-ip-country, etc.)
# No external provider keys needed when deployed on Vercel.
# For non-Vercel deployments, implement a provider in lib/analytics/geolocation.ts

# Rate Limiting (configured in code, not via env)
# Contact: 5/hr per email, 3/hr per IP
# Analytics: 60/min per IP

# Data Retention (configured in code)
# Raw events: 90 days
# Aggregated: 365 days